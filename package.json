{
  "name": "dsh-whale-bongo",
  "version": "0.3.5",
  "description": "QQ 弹弹的类 bongo 手手挂件",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/portrait.png",
    "assets/key-angles.json",
    "assets/dsh-whale-bongo-icon.png",
    "assets/widget.js",
    "assets/mods/*",
    "assets/sounds/*",
    "README.md",
    "INSTALL-FOR-AI.md",
    "LICENSE",
    "CHANGELOG.md",
    "desktop.js",
    "electron-runtime.js",
    "runtime/electron-helper",
    "scripts/ensure-electron.mjs",
    "scripts/build-native-helper.mjs",
    "tests",
    "global-keys-host.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "icon": "icon.png",
  "author": "MeteorNOX",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "typing",
    "widget",
    "bongo",
    "desktop-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteorNOX/dsh-whale-bongo.git"
  },
  "bugs": {
    "url": "https://github.com/MeteorNOX/dsh-whale-bongo/issues"
  },
  "homepage": "https://github.com/MeteorNOX/dsh-whale-bongo#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.1"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check assets/widget.js && node --check assets/mods/audio-beat.js && node --check electron-runtime.js && node --check runtime/electron-helper/main.js && node --check runtime/electron-helper/preload.js && node --check runtime/electron-helper/desktop-renderer.js && node --check runtime/electron-helper/audio-beat.js && node --check runtime/electron-helper/audio-beat-worker.js && node --check runtime/electron-helper/window-dip.js && node --check runtime/electron-helper/macos-monitor.js && node --check global-keys-host.js",
    "test": "node --test tests/*.test.cjs",
    "build:native": "node scripts/build-native-helper.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs"
  }
}
